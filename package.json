{
  "name": "ciki-helper",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "在源文档页一键剪藏到 Ciki 的 Chrome MV3 插件",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture": "node test/servers/index.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-code-block": "3.33.0",
    "@tiptap/extension-color": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-table-cell": "3.33.0",
    "@tiptap/extension-table-header": "3.33.0",
    "@tiptap/extension-table-row": "3.33.0",
    "@tiptap/extension-task-item": "3.33.0",
    "@tiptap/extension-task-list": "3.33.0",
    "@tiptap/extension-text-style": "3.33.0",
    "@tiptap/extension-underline": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.15",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
