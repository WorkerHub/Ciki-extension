{
  "manifest_version": 3,
  "name": "ciki 搬运助手",
  "version": "1.0.0",
  "description": "把 Confluence 页面整页搬到 ciki：借浏览器登录态只读取正文与附件原图，经确认后写入 ciki。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ciki 搬运助手"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
