{
  "manifest_version": 3,
  "name": "Ciki助手",
  "version": "1.0.4",
  "description": "在源文档页一键剪藏到 Ciki：借浏览器登录态读取正文与附件原图，经你确认后写入。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ciki助手"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
